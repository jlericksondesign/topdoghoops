# Public app URL used for generated links.
# For the Vercel demo, use the temporary vercel.app URL first.
# After the domain is connected, use https://www.topdoghoops.com.
APP_BASE_URL=http://localhost:3000

# Temporary admin passcode for the protected /admin demo screen.
ADMIN_ACCESS_PASSWORD=

# Supabase is not connected in the current UI-only demo build.
# Keep these empty until backend wiring starts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Top Dog Hoops <hello@topdoghoops.com>"
RESEND_REPLY_TO_EMAIL=

# Temporary pre-launch legal/privacy review page.
# Do not link publicly. Remove after launch review is complete.
LEGAL_REVIEW_ACCESS_CODE=
LEGAL_REVIEW_NOTIFY_EMAIL=
LEGAL_REVIEW_DOC_URL=
LEGAL_REVIEW_PRIVACY_DOC_URL=
LEGAL_REVIEW_TERMS_DOC_URL=
LEGAL_REVIEW_CONSENT_DOC_URL=
